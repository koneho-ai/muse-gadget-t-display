# LILYGO T-Display (the original TTGO T-Display, not the T-Display-S3):
# classic ESP32 (Xtensa dual-core LX6, 2.4 GHz Wi-Fi, BLE 4.2), 16 MB flash,
# no PSRAM, CH9102 USB-UART bridge (some older units shipped with a CP2104 or
# CH340), and a 1.14 inch 135x240 ST7789V display. Load last, after
# sdkconfig.defaults (see README.md in this directory).
#
# Pins (LILYGO's TTGO-T-Display repo, README pin table and
# TFT_eSPI/User_Setups/Setup25_TTGO_T_Display.h): MOSI 19, SCLK 18, CS 5,
# DC 16, RST 23, backlight 4. Buttons on GPIO35 (left) and GPIO0 (right).
# For the 4 MB flash version of this board, use sdkconfig.lilygo-t-display-4mb
# instead; everything else about the two profiles is the same.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# No status LED: the display shows the status colour in edge bars.
CONFIG_HOMEHUB_LED_BACKEND_LILYGO_TDISPLAY_ST7789=y
# Advertise as <prefix>-Disp-XXXXXX to tell this board apart from real devices:
# MuseGadget-Disp in the open-source build, HomeLink-Disp in the internal one.
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Disp"
# The right-hand button (GPIO0, also the BOOT button), active low. The
# left-hand button on GPIO35 is not used by this profile.
CONFIG_HOMEHUB_BUTTON_GPIO=0

# Signed apps without Secure Boot use the Secure Boot V2 (RSA) scheme, which
# the ESP32 supports from chip revision 3.0 (ESP32-D0WD-V3).
CONFIG_ESP32_REV_MIN_3=y

# No PSRAM. mbedtls and every PSRAM-preferred buffer fall back to internal RAM.
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# 16 KB TLS records in both directions would cost 32 KB of internal RAM per
# connection. Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Release the classic Bluetooth controller memory; pairing is BLE only.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Fewer static Wi-Fi RX buffers (1.6 KB each, always resident). The RX block-ack
# window may be at most twice the static buffer count.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# The ESP32 has far less IRAM than the C5; keep lwIP and Wi-Fi hot paths in
# flash so the image links.
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# No PSRAM: the home-network tunnel and network discovery do not fit next to
# the control session. Only the control API to the VM is available.
CONFIG_HOMEHUB_TUNNEL=n

# 16 MB flash; the SDK's standard 8 MB-style partition table (dual 2 MB OTA
# slots plus the fixed prod_data/prod_bak) fits unchanged. DIO is the safe
# mode for this board's flash part.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
